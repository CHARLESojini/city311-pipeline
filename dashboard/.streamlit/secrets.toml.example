# Copy to dashboard/.streamlit/secrets.toml for local runs (gitignored), or paste
# into Streamlit Community Cloud > your app > Settings > Secrets.
# Leave the [snowflake] section out entirely to run on the DuckDB demo data.

[snowflake]
account = "<ORGNAME-ACCOUNTNAME>"
user = "STREAMLIT_SVC"
role = "REPORTER"
warehouse = "NYC311_WH"
database = "NYC311"
# Full PEM text of STREAMLIT_SVC's private key (not the pipeline's key).
# Paste it inside the triple quotes, keeping its BEGIN/END lines.
private_key = """
<PASTE THE FULL PEM TEXT OF rsa_key_streamlit.p8 HERE>
"""
# private_key_passphrase = "<only if the key is encrypted>"
