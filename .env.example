# city311-pipeline configuration template.
#
#   cp .env.example airflow/.env      # Astro CLI loads airflow/.env into every container
#   set -a; source airflow/.env; set +a   # same values for local dbt / scripts
#
# Placeholders only. Real values live in airflow/.env, which is gitignored,
# along with every *.env file. Never commit real values, and never paste them
# into code: everything reads from these variables at run time.

# ---------------------------------------------------------------- AWS (S3 landing)
# Credentials come from ~/.aws, mounted read-only into the containers
# (docker-compose.override.yml). Choose the profile and region here.
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-1
# The container's HOME is not the mount path, so point boto3 at the files explicitly
AWS_SHARED_CREDENTIALS_FILE=/usr/local/airflow/.aws/credentials
AWS_CONFIG_FILE=/usr/local/airflow/.aws/config
CITY311_BUCKET=<YOUR_BUCKET>
# Days of created-or-closed records each daily run re-extracts (publication lag)
CITY311_LOOKBACK_DAYS=3

# ---------------------------------------------------------------- Snowflake
# Account identifier, e.g. orgname-accountname (Admin > Accounts in Snowsight)
SNOWFLAKE_ACCOUNT=<ORGNAME-ACCOUNTNAME>
SNOWFLAKE_USER=AIRFLOW_SVC
# Key-pair auth: the private key stays in ~/.snowflake (mounted read-only);
# only its public half is registered in Snowflake (snowflake/04_airflow_service_user.sql)
SNOWFLAKE_PRIVATE_KEY_PATH=/usr/local/airflow/.snowflake/rsa_key.p8

# Airflow connection used by the ingest DAG (COPY INTO as PIPELINE_LOADER)
AIRFLOW_CONN_SNOWFLAKE_DEFAULT='{"conn_type": "snowflake", "login": "AIRFLOW_SVC", "extra": {"account": "<ORGNAME-ACCOUNTNAME>", "warehouse": "NYC311_WH", "database": "NYC311", "role": "PIPELINE_LOADER", "private_key_file": "/usr/local/airflow/.snowflake/rsa_key.p8"}}'

# ---------------------------------------------------------------- dbt
DBT_TARGET=prod
# Local development only: your own schema prefix for the dev target
DBT_DEV_SCHEMA=DBT_DEV

# ---------------------------------------------------------------- AI insights layer
# https://console.anthropic.com > API keys. Without it, the AI task logs and skips.
ANTHROPIC_API_KEY=
CITY311_AI_MODEL=claude-haiku-5-5
# Slack incoming webhook (optional). Without it, reports are only stored in Snowflake.
SLACK_WEBHOOK_URL=
# Linked from the Slack message (optional)
CITY311_DASHBOARD_URL=
